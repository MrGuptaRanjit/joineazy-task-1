{
  "name": "joineazy-backend",
  "version": "1.0.0",
  "description": "Student, Group & Assignment Management System - Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:init": "node src/db/migrate.js && node src/db/seed.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "nodemon": "^3.1.4",
    "pg-mem": "^3.0.14",
    "supertest": "^7.2.2"
  }
}
